<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The real look of the app is defined in Compose (ui/theme). This theme only
         covers the window itself. -->
    <style name="Theme.SowarApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>

    <!-- Splash screen shown while the app starts: the flower logo on the brand rose color. -->
    <style name="Theme.SowarApp.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SowarApp</item>
    </style>
</resources>
